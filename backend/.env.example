# Application Settings
PROJECT_NAME="API Sentinel"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Security & JWT
# IMPORTANT: Generate a secure secret in production using: openssl rand -hex 32
SECRET_KEY="insecure-change-this-in-production-secret-key-32chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# Default to SQLite local database
DATABASE_URL="sqlite:///./api_sentinel.db"

# HTTP Outbound Runner Limits (SSRF & DoS Protection)
OUTBOUND_REQUEST_TIMEOUT_SECONDS=10
OUTBOUND_MAX_RESPONSE_BYTES=5242880 # 5 MB
OUTBOUND_MAX_REDIRECTS=3

